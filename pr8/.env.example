# Скопіюйте цей файл у .env. Ключ доступу — той самий, що в ПР3–ПР7:
# перенесіть його з тамтешнього .env.
# Файл .env до репозиторію не потрапляє — ключ доступу є секретом.

# ---- Мовна модель (як у ПР3–ПР7) ----

# Адреса OpenAI-сумісного ендпоінта Gemini. Змінювати не потрібно.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ключ із Google AI Studio: https://aistudio.google.com → Get API key
LLM_API_KEY=

# Назва моделі. Потрібна модель, що підтримує виклик інструментів
# (function calling); моделі Gemini лінійки flash підтримують.
LLM_MODEL=gemini-3.8-flash

# Вибір інструмента й аргументів — не творча задача: температура нульова.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=800

# Скільки секунд чекати на одну відповідь моделі.
LLM_TIMEOUT=30

# ---- Інструменти (нове) ----

# Скільки разів за одне питання можна звернутися до моделі. Одне
# звертання — відповідь без інструментів; два — один раунд викликів і
# відповідь; далі — ланцюжок, у якому наступний виклик залежить від
# результату попереднього. Значення — відправна точка, а не відповідь.
TOOL_MAX_ROUNDS=3

# ---- Сервіс магазину ----

# Сьогоднішня дата сервісу: від неї рахуються строки повернення.
SHOP_TODAY=2026-10-06

# Імітація повільного й ненадійного сервісу: затримка кожного виклику в
# мілісекундах і частка викликів, що завершуються відмовою (від 0 до 1).
SHOP_DELAY_MS=0
SHOP_FAILURE_RATE=0
