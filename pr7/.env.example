# Скопіюйте цей файл у .env. Ключ доступу — той самий, що в ПР3–ПР6:
# перенесіть його з тамтешнього .env.
# Файл .env до репозиторію не потрапляє — ключ доступу є секретом.

# ---- Мовна модель (як у ПР3–ПР6) ----

# Адреса OpenAI-сумісного ендпоінта Gemini. Змінювати не потрібно.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ключ із Google AI Studio: https://aistudio.google.com → Get API key
LLM_API_KEY=

# Назва моделі. Потрібна модель, що приймає зображення; моделі Gemini
# лінійки flash приймають. Перелік дивіться в Google AI Studio.
LLM_MODEL=gemini-3.8-flash

# Вилучення — не творча задача: температура нульова. Запас max_tokens —
# на всі поля й таблицю позицій: рахунок з одинадцятьма рядками дає
# помітно довший JSON, ніж відповідь помічника в ПР6.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2500

# Зображення обробляється довше, ніж текст.
LLM_TIMEOUT=60

# ---- Зображення (нове) ----

# Найбільший розмір файлу, який приймає застосунок, у мегабайтах.
UPLOAD_MAX_MB=10

# До якого розміру за довшою стороною зменшувати зображення перед
# надсиланням моделі. Менше — дешевше й швидше, але дрібні цифри
# зливаються. Значення — відправна точка, а не відповідь.
IMAGE_MAX_SIDE=1600
